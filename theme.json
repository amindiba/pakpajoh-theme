{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "layout": { "contentSize": "1600px", "wideSize": "1600px" },
        "color": {
            "palette": [
                { "slug": "primary", "color": "#2D2D2D", "name": "گرافیتی" },
                { "slug": "accent", "color": "#C9A227", "name": "طلایی" },
                { "slug": "light", "color": "#FAFAF7", "name": "پس‌زمینه روشن" },
                { "slug": "muted", "color": "#8A8A8A", "name": "خاکستری" },
                { "slug": "white", "color": "#FFFFFF", "name": "سفید" }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Vazirmatn', Tahoma, sans-serif",
                    "name": "Vazirmatn",
                    "slug": "vazirmatn"
                }
            ],
            "fontSizes": [
                { "slug": "small", "size": "14px", "name": "کوچک" },
                { "slug": "medium", "size": "16px", "name": "متوسط" },
                { "slug": "large", "size": "24px", "name": "بزرگ" },
                { "slug": "x-large", "size": "32px", "name": "خیلی بزرگ" }
            ]
        },
        "spacing": {
            "units": ["px", "em", "rem", "%", "vw", "vh"],
            "spacingSizes": [
                { "slug": "40", "size": "1rem", "name": "کوچک" },
                { "slug": "50", "size": "2rem", "name": "متوسط" },
                { "slug": "60", "size": "3rem", "name": "بزرگ" },
                { "slug": "70", "size": "4rem", "name": "خیلی بزرگ" }
            ]
        }
    },
    "styles": {
        "color": { "background": "var:preset|color|light", "text": "var:preset|color|primary" },
        "typography": { "fontFamily": "var:preset|font-family|vazirmatn", "fontSize": "var:preset|font-size|medium" },
        "spacing": { "padding": { "top": "0", "bottom": "0" } }
    }
}
