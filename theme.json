{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "palette": [
        { "slug": "primary",     "color": "#2D2D2D", "name": "گرافیتی تیره" },
        { "slug": "accent",      "color": "#C9A227", "name": "طلایی" },
        { "slug": "accent-hover","color": "#B08D1A", "name": "طلایی تیره" },
        { "slug": "light",       "color": "#FAFAF7", "name": "پس‌زمینه روشن" },
        { "slug": "muted",       "color": "#8A8A8A", "name": "متن خاکستری" },
        { "slug": "white",       "color": "#FFFFFF", "name": "سفید" }
      ],
      "gradients": [
        { "slug": "hero-gradient", "gradient": "linear-gradient(135deg, #2D2D2D 0%, #1a1a1a 100%)", "name": "گرادیانت هیرو" },
        { "slug": "accent-gradient", "gradient": "linear-gradient(135deg, #C9A227 0%, #B08D1A 100%)", "name": "گرادیانت طلایی" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "customFontFamily": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "vazirmatn",
          "name": "وزیرمتن",
          "fontFamily": "Vazirmatn, Tahoma, Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Vazirmatn",
              "fontWeight": "300 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/Vazirmatn-Variable.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small",   "size": "0.875rem", "name": "کوچک" },
        { "slug": "medium",  "size": "1rem",     "name": "متوسط" },
        { "slug": "large",   "size": "1.25rem",  "name": "بزرگ" },
        { "slug": "x-large", "size": "1.75rem",  "name": "خیلی بزرگ" },
        { "slug": "xx-large","size": "2.5rem",   "name": "بزرگ‌تر" },
        { "slug": "huge",    "size": "clamp(3rem, 6vw, 5rem)", "name": "عظیم" }
      ]
    },
    "spacing": {
      "units": ["px","em","rem","vh","vw","%"],
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "1rem",   "name": "S" },
        { "slug": "40", "size": "1.5rem", "name": "M" },
        { "slug": "50", "size": "2.5rem", "name": "L" },
        { "slug": "60", "size": "4rem",   "name": "XL" },
        { "slug": "70", "size": "6rem",   "name": "XXL" }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "soft",   "shadow": "0 4px 16px rgba(0,0,0,0.06)", "name": "نرم" },
        { "slug": "medium", "shadow": "0 8px 32px rgba(0,0,0,0.10)", "name": "متوسط" },
        { "slug": "gold",   "shadow": "0 8px 24px rgba(201,162,39,0.25)", "name": "طلایی" }
      ]
    },
    "border": { "radius": true, "color": true, "style": true, "width": true },
    "blocks": { "core/button": { "border": { "radius": true } } }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--light)", "text": "var(--wp--preset--color--primary)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--vazirmatn)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.8" },
    "spacing": { "padding": { "left": "0", "right": "0" } },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--accent)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent-hover)" } } },
      "heading": { "typography": { "fontWeight": "700", "lineHeight": "1.3" }, "color": { "text": "var(--wp--preset--color--primary)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--white)" },
        "border": { "radius": "8px" },
        "typography": { "fontWeight": "600" },
        ":hover": { "color": { "background": "var(--wp--preset--color--accent-hover)", "text": "var(--wp--preset--color--white)" } }
      }
    },
    "blocks": { "core/site-title": { "typography": { "fontWeight": "800" } } }
  },
  "customTemplates": [
    { "name": "page", "title": "برگه استاندارد", "postTypes": ["page"] },
    { "name": "single", "title": "نوشته تک", "postTypes": ["post"] },
    { "name": "archive", "title": "آرشیو", "postTypes": ["post"] }
  ]
}